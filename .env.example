# Base URL of the backend API (no trailing slash, no /api suffix).
# Local dev default (used when unset): http://localhost:8081
# Production: set this in your host's dashboard (e.g. Vercel project settings)
# to your deployed backend's URL, e.g. https://dsatrackerapi.sakshamsingla.com
VITE_API_BASE=http://localhost:8081
